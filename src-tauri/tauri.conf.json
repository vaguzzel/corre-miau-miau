{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Corre Miau Miau",
  "version": "1.0.0",
  "identifier": "io.github.vaguzzel.corremiaumiau",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Corre Miau Miau",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Juego tipo Pac-Man en pixel art",
    "longDescription": "Quesito recorre la casa comiendo queso mientras Tomasito, Begoña y Eren lo persiguen.",
    "category": "Game"
  }
}
